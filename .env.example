# Copy only when creating a new local environment. Preserve your existing .env and BANK_ENCRYPTION_KEY.
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/?retryWrites=true&w=majority&appName=CKXchange
MONGODB_DB=ckxchange
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
BANK_ENCRYPTION_KEY=replace-with-64-hex-characters
INR_PER_USDT=106
DEPOSIT_ADDRESS_TRC20=
# Optional: generate with `node scripts/generate-vapid.js`. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_SUPPORT_EMAIL@example.com
