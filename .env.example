# MongoDB Atlas connection string. Create a database user and allow your host IP in Atlas Network Access.
# Encode special characters in the username/password. Never commit your real .env.
MONGODB_URI=
MONGODB_DB=ckxchange
# Optional connection pool/timeouts.
MONGODB_MAX_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

NODE_ENV=development
PORT=3000
# Required on Vercel: exact public origin, e.g. https://your-project.vercel.app
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -hex 32. Keep the same key to decrypt previously saved bank account numbers.
BANK_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
# Default reference rate until an admin saves a rate in the Admin panel.
INR_PER_USDT=106
# Optional TRC20 address fallback until an admin saves an address in the Admin panel.
DEPOSIT_ADDRESS_TRC20=
