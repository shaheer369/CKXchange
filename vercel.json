{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "regions": [
    "bom1"
  ],
  "functions": {
    "server.js": {
      "maxDuration": 30,
      "includeFiles": "views/**"
    }
  },
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
